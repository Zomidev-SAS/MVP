# Supabase local (después de `supabase start` en la raíz del repo):
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<ver output de `supabase status`>

# Supabase cloud:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Producción (carrera.zomidev.com) — necesario para recuperar contraseña / auth callback
# NEXT_PUBLIC_SITE_URL=https://carrera.zomidev.com

# Desarrollo local únicamente. Nunca se activa en producción (NODE_ENV check).
# Comentar estas líneas para probar login real contra Supabase.
# DEV_SKIP_AUTH=true
# NEXT_PUBLIC_DEV_SKIP_AUTH=true
# DEV_SKIP_AUTH_ROLE=supervisor

# Requerido en producción para que el modo pantalla /planta/[token] (kiosco
# de taller sin sesión) sea seguro — sin esto, el despliegue falla cerrado
# (ver lib/supabase/planta-actions.ts) en vez de usar un secreto de desarrollo
# conocido.
# PLANTA_KIOSK_SECRET=<genera con: openssl rand -base64 32>
